NODE_ENV=production
PORT=4000
LOG_LEVEL=info
DATABASE_SSL=require
DATABASE_POOL_MAX=20
CORS_ORIGINS=<https://daregular.com>,<https://api.daregular.com>
PUBLIC_URL=<https://api.daregular.com>
STOREFRONT_URL=<https://daregular.com>
ADMIN_URL=<https://daregular.com>
TRUST_PROXY=1
THROTTLE_TTL_MS=60000
