# Copia a .env y ajusta. Las variables reales del entorno siempre tienen prioridad.
# Todas se validan con Zod al arrancar (src/config/env.ts). NUNCA pongas secretos reales en este archivo.
# Las marcadas [PROD] son obligatorias con NODE_ENV=production (en desarrollo son opcionales).

# ══ Fase 0 · Fundación ══
NODE_ENV=development                # development | test | production
PORT=4000
LOG_LEVEL=debug                     # fatal | error | warn | info | debug | trace | silent
GIT_SHA=                            # lo inyecta CI/despliegue; lo muestra GET /version

# Dev sin Docker: `yarn db:start` levanta este Postgres embebido en el puerto 5433.
# No uses ?sslmode= en la URL: el TLS se configura con DATABASE_SSL.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/department
DATABASE_SSL=disable                # disable | require | verify-full   [PROD: require o verify-full]
# DATABASE_CA_CERT=                 # PEM de la CA (solo verify-full con hosts sin CA de sistema, p. ej. Supabase)
DATABASE_POOL_MAX=10

# Orígenes del navegador permitidos (sin barra final). [PROD: https://]
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_URL=http://localhost:4000    # [PROD: https://]
STOREFRONT_URL=http://localhost:3000  # [PROD: https://] destino del webhook de revalidación
ADMIN_URL=http://localhost:3001     # [PROD: https://]

# Saltos de proxy de confianza (Railway = 1, Cloudflare + Railway = 2) o lista de IP/CIDR. Nunca "true".
TRUST_PROXY=false                   # [PROD: obligatorio distinto de false]
# DOCS_ENABLED=true                 # Swagger /docs y /docs-json (por defecto: activo salvo en production)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Carpeta del driver de disco local para media (y CSV de importación en UPLOAD_DIR/imports)
UPLOAD_DIR=./uploads

# ══ Fase 1 · Identidad (personal) ══
# Generar con: openssl rand -hex 32
# JWT_ACCESS_SECRET=                # [PROD]
# Cifra secretos de terceros guardados. Generar con: openssl rand -base64 32 (32 bytes exactos)
# ENCRYPTION_KEY=                   # [PROD]

# 2FA obligatorio para roles con staff:write o settings:write (owner/admin): sin 2FA activo solo pueden configurarlo (403 TWO_FACTOR_SETUP_REQUIRED).
# Por defecto true con NODE_ENV=production y false en el resto. REQUIRE_STAFF_2FA=false en producción arranca con un aviso (warning) en el log.
# REQUIRE_STAFF_2FA=false
# `yarn owner:create` obliga a cambiar la contraseña en el primer login (403 PASSWORD_CHANGE_REQUIRED). false SOLO para CI/smoke: con NODE_ENV=production el arranque lo rechaza.
# OWNER_MUST_CHANGE_PASSWORD=true

# Bootstrap del primer Owner: `yarn owner:create` (o el smoke en CI)
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=

# ══ Fase 3 · CMS ══
# Al arrancar, crea el contenido por defecto del sitio (ajustes, menús, plantillas, páginas) SOLO si no existe; nunca pisa lo editado en el admin.
SEED_DEFAULT_CONTENT=true          # true | false
# PREVIEW_TOKEN_SECRET=             # [PROD] firma los tokens de vista previa (1 h)
# STOREFRONT_REVALIDATE_SECRET=     # [PROD] compartido con el front: firma HMAC del webhook POST {STOREFRONT_URL}/api/revalidate
# STOREFRONT_SERVER_KEY=            # [PROD] el servidor Next lo envía en X-Storefront-Key para poder reenviar X-Visitor-Ip (rate limit por visitante)

# ══ Fase 4 · Carrito, checkout y pagos ══
PAYMENT_PROVIDER=mock               # mock | wompi   [PROD: wompi]
MOCK_PAYMENTS_ENABLED=false         # SOLO desarrollo/CI: true permite POST /storefront/dev/mock-payment. [PROD: false]
ORDER_RESERVATION_MINUTES=30        # minutos que un pedido sin pagar conserva el stock reservado (5-1440)
WOMPI_API_URL=https://sandbox.wompi.co/v1   # producción: https://production.wompi.co/v1
# WOMPI_EXPIRATION_ENABLED=false    # true: manda expirationTime (= reserva del pedido) y lo firma. Activar SOLO cuando el front lo reenvíe como `expiration-time`
# WOMPI_PUBLIC_KEY=                 # [PROD]
# WOMPI_INTEGRITY_SECRET=           # [PROD]
# WOMPI_EVENTS_SECRET=              # [PROD] verifica la firma de los eventos en /webhooks/wompi

# ══ Fase 5 · Correo y clientes ══
MAIL_TRANSPORT=log                  # log (solo registra en la bandeja de salida) | smtp   [PROD: smtp]
# SMTP_URL=smtp://user:pass@host:587   # [PROD]
MAIL_FROM="Daregular Dept. <no-reply@daregulardept.com>"
# CUSTOMER_JWT_SECRET=              # [PROD] JWT de clientes (distinto del de personal)
