# Copia a .env y ajusta. Las variables reales del entorno siempre tienen prioridad.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Dev sin Docker: `yarn db:start` levanta este Postgres embebido en el puerto 5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/department
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

TRUST_PROXY=false
# DOCS_ENABLED=true   (por defecto: activo salvo en production)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ── Production-only secrets (required when NODE_ENV=production) ──
# DATABASE_SSL=verify-full  (+ DATABASE_CA_CERT if needed)
# TRUST_PROXY=1             (number of proxy hops)
# JWT_ACCESS_SECRET=  JWT_REFRESH_SECRET=  PREVIEW_TOKEN_SECRET=  STOREFRONT_REVALIDATE_SECRET=  STOREFRONT_SERVER_KEY=   (openssl rand -hex 32)
# ENCRYPTION_KEY=           (openssl rand -base64 32)

# ── Pagos (Fase 4) ──
# PAYMENT_PROVIDER=mock            # en producción: wompi
# MOCK_PAYMENTS_ENABLED=true     # SOLO desarrollo: permite aprobar pedidos sin pagar
# WOMPI_PUBLIC_KEY=  WOMPI_INTEGRITY_SECRET=  WOMPI_EVENTS_SECRET=
# ORDER_RESERVATION_MINUTES=30

# ── Correo y clientes (Fase 5) ──
# MAIL_TRANSPORT=log             # en producción: smtp
# SMTP_URL=smtp://user:pass@host:587
# MAIL_FROM="Daregular Dept. <no-reply@daregulardept.com>"
# CUSTOMER_JWT_SECRET=           # openssl rand -hex 32
