# Copia a .env y ajusta. Las variables reales del entorno siempre tienen prioridad.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Dev sin Docker: `yarn db:start` levanta este Postgres embebido en el puerto 5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/department
DATABASE_SSL=false
DATABASE_POOL_MAX=10

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

TRUST_PROXY=false
# DOCS_ENABLED=true   (por defecto: activo salvo en production)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
