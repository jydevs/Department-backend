{
  "name": "department-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend headless de Daregular Dept. (NestJS + TypeORM + PostgreSQL)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:start": "node scripts/dev-db.mjs",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "migration:generate": "yarn typeorm migration:generate",
    "smoke": "node scripts/smoke.mjs",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "owner:create": "ts-node -r tsconfig-paths/register scripts/create-owner.ts",
    "content:complete": "ts-node -r tsconfig-paths/register scripts/complete-storefront.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@nestjs/throttler": "^6",
    "@nestjs/typeorm": "^11",
    "argon2": "^0.45.1",
    "csv-parse": "^7.0.3",
    "helmet": "^8.3.0",
    "image-size": "^2.0.4",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.2.0",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.7",
    "typeorm": "^1.1.1",
    "uuid": "^11.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@types/express": "^5",
    "@types/multer": "^2.2.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1"
  }
}
